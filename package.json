{
  "name": "mcwebui-workspace",
  "version": "0.1.0-dev",
  "private": true,
  "workspaces": [
    "frontend/packages/*",
    "frontend/playground"
  ],
  "scripts": {
    "build:web": "npm run build --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm --workspace @mcwebui/playground run dev --if-present"
  }
}
